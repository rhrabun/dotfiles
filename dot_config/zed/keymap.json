// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      // Open and close panels
      "ctrl-e": "project_panel::Toggle",
      "ctrl-alt-j": "terminal_panel::Toggle",
      "alt-shift-l": "git_panel::Toggle",
      "alt-shift-h": "agent::Toggle",
      "ctrl-alt-y": "editor::ToggleEditPrediction",
      // Zen mode
      "ctrl-alt-z": "workspace::ToggleCenteredLayout",
      // Maximize editor group
      "ctrl-alt-m": "workspace::ToggleEditorZoom",
      // New terminal
      "ctrl-alt-n": "workspace::NewTerminal",
      // Resize active pane width
      "ctrl-alt-.": "vim::ResizePaneRight",
      "ctrl-alt-,": "vim::ResizePaneLeft",
      "space f s": "zed::OpenSettingsFile",
      "space f k": "zed::OpenKeymapFile",
    },
  },
  // Panes navigation
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      // Focus file explorer; elsewhere ctrl-e toggles the panel
      "ctrl-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space c f": "editor::Format",
      // Panes splits
      "space r": "pane::SplitRight",
      "space v": "pane::SplitRight",
      "space h": "pane::SplitDown",
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "ctrl-alt-h": "pane::ActivatePreviousItem",
      "ctrl-alt-l": "pane::ActivateNextItem",
      "space ,": "tab_switcher::Toggle",
      // Nice to have
      "space w": "workspace::SaveWithoutFormat",
      "space q": "pane::CloseActiveItem",
      "space w q": ["workspace::SendKeystrokes", "space w space q"],
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "k j": "vim::NormalBefore",
      "ctrl-space": "editor::ShowCompletions",
    },
  },
  {
    "context": "Editor && (showing_completions || edit_prediction)",
    "bindings": {
      "enter": "editor::Newline",
      "escape": "editor::Cancel",
    },
  },
  // Move lines
  {
    "context": "Editor && !readonly",
    "bindings": {
      "alt-shift-j": "editor::MoveLineDown",
      "alt-shift-k": "editor::MoveLineUp",
    },
  },
  // File Tree
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "d": "project_panel::Trash",
      "shift-n": "project_panel::NewDirectory",
    },
  },
  // Git panel
  {
    "context": "GitPanel",
    "bindings": {
      "q": "git_panel::Close",
    },
  },
  // Terminal
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-r": "terminal::RenameTerminal",
    },
  },
  // Empty pane, set of keybindings that are available when there is no active editor
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // Open file finder
      "space space": "file_finder::Toggle",
      // New file
      "space f n": "workspace::NewFile",
      // Open recent project
      "space f p": "projects::OpenRecent",
      // Search in all the files
      "space s g": "workspace::NewSearch",
      // Quit zed
      "space q q": "zed::Quit",
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // Refactoring
      "space c r": "editor::Rename",
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      // Git
      "space g g": "git_panel::ToggleFocus",
      "space g h d": "editor::ExpandAllDiffHunks",
      "space g h D": "git::Diff",
      "space g h r": "git::Restore",
      "space g h R": "git::RestoreFile",
      // Toggle inlay hints
      "space u i": "editor::ToggleInlayHints",
      // Toggle soft wrap
      "space u w": "editor::ToggleSoftWrap",
      // Open markdown preview
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",
      // Extensions (lazy)
      "space l": "zed::Extensions",
      // Pin / unpin tab
      "space b p": "pane::TogglePinTab",
      "space b u": "pane::TogglePinTab",
      // Theme selector
      "space u C": "theme_selector::Toggle",
      // Search word under cursor in current pane
      "space s w": "buffer_search::Deploy",
      // Search word under cursor in all panes
      "space s W": "pane::DeploySearch",
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "space ,": "tab_switcher::Toggle",
      // Jump to the previous location
      "space b b": "pane::AlternateFile",
      // Close buffer
      "space b d": "pane::CloseActiveItem",
      // Close inactive buffers
      "space b q": "pane::CloseOtherItems",
      // Close all buffers
      "space b D": ["pane::CloseAllItems", { "close_pinned": false }],
      // New file
      "space f n": "workspace::NewFile",
      // Search in the current buffer
      "space s b": "vim::Search",
      // Search in all the files
      "space s g": "workspace::NewSearch",
      // Search
      "space /": "workspace::NewSearch",
      // Git
      "space g b": "git::Blame",
      // LSP & Code actions
      "space c a": "editor::ToggleCodeActions",
      "space s d": "diagnostics::Deploy",
      "space s s": "outline::Toggle",
      "g d": "editor::GoToDefinition",
      "g r": "editor::FindAllReferences",
      "g D": "editor::GoToDeclaration",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      // Search word under cursor
      "g w": ["workspace::SendKeystrokes", "*"],
      "K": "editor::Hover",
      "g K": "editor::ShowSignatureHelp",
      // Format
      "space c f": "editor::Format",
      // Telescope
      "space space": "file_finder::Toggle",
      // Quit zed
      "space q q": "zed::Quit",
      // Jump to hunks
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",
      // Jump to diagnostic
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": ["editor::GoToDiagnostic", { "severity": { "min": "error", "max": "error" } }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": { "min": "error", "max": "error" } }],
      "] w": ["editor::GoToDiagnostic", { "severity": { "min": "warning", "max": "warning" } }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": { "min": "warning", "max": "warning" } }],
      // Excerpts
      "] q": "editor::MoveToStartOfNextExcerpt",
      "[ q": "editor::MoveToStartOfExcerpt",
    },
  },
  // Center the cursor on the screen when scrolling
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z z v"],
    },
  },
  // Extras when deleting
  {
    "context": "vim_operator == d",
    "bindings": {
      "o": "editor::ExpandAllDiffHunks",
      "r": "git::Restore",
    },
  },
  // EasyMotion / Sneak
  {
    "context": "vim_mode == normal",
    "bindings": {
      "s": "vim::PushSneak",
      "S": "vim::PushSneakBackward",
    },
  },
  // Surround
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
    },
  },
]
