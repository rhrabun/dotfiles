{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md",
    "~/.agents/instructions/*.md"
  ],
  "model": "~deepseek/deepseek-v4-flash-latest",
  "autoupdate": false,
  "references": {
    "omarchy": {
      "repository": "basecamp/omarchy",
      "description": "Use for Omarchy config and manual details"
    }
  },
  "mcp": {
    "executor": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:4788/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.executor/server-control/token}"
      }
      // Local stdio alternative — no token. Bridges to whatever daemon owns
      // the data dir (starts one in the background if none is running).
      // Requires bun via mise; EXECUTOR_DATA_DIR must match `make run`.
      // "executor-local": {
      //   "type": "local",
      //   "command": ["mise", "exec", "--", "bun", "run", "/Users/roman/code/executor/apps/cli/src/main.ts", "mcp"],
      //   "environment": { "EXECUTOR_DATA_DIR": "/Users/roman/.executor" }
      // }
    }
  }
}
