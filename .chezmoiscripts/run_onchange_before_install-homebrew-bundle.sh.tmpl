{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Install Homebrew formulae, casks and MAS apps from the Brewfile.
# Re-runs when the Brewfile changes (see the checksum comment below).
# Brewfile checksum: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

if [[ -x /opt/homebrew/bin/brew ]]; then
    brew_bin="/opt/homebrew/bin/brew"
elif [[ -x /usr/local/bin/brew ]]; then
    brew_bin="/usr/local/bin/brew"
elif command -v brew >/dev/null 2>&1; then
    brew_bin="$(command -v brew)"
else
    printf '%s\n' "Homebrew not found; skipping brew bundle install." >&2
    exit 0
fi

brewfile={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}

"$brew_bin" bundle check --no-upgrade --file "$brewfile" >/dev/null 2>&1 \
    || "$brew_bin" bundle install --no-upgrade --file "$brewfile"
{{- end -}}