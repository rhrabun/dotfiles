{
  // Per-environment settings
  "amazonQ.telemetry": false,

  // General
  "update.mode": "manual",
  "extensions.autoUpdate": "off",
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.autoCheckUpdates": false,
  "security.workspace.trust.untrustedFiles": "open",
  // Visual
  "editor.fontSize": 16,
  "editor.fontFamily": "'FiraCode Nerd Font', 'Cascadia Code', 'Fira Code'",
  "editor.fontLigatures": true,
  "chat.fontSize": 16,
  "chat.fontFamily": "'FiraCode Nerd Font', 'Cascadia Code', 'Fira Code'",
  "chat.editor.fontSize": 16,
  "chat.editor.fontFamily": "'FiraCode Nerd Font Mono', 'Cascadia Mono', 'Fira Mono'",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', 'Cascadia Mono', 'Fira Mono'",
  "window.customTitleBarVisibility": "auto",
  "window.autoDetectColorScheme": true,
  "workbench.colorTheme": "Catppuccin Frappé",
  "workbench.preferredDarkColorTheme": "Catppuccin Frappé",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "catppuccin-frappe",
  "catppuccin-icons.hidesExplorerArrows": true,
  "catppuccin.syncWithIconPack": false,
  "catppuccin.italicKeywords": false,
  "catppuccin.bracketMode": "dimmed",
  "editor.minimap.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.editor.enablePreview": false,
  "explorer.autoReveal": false,
  "files.autoSave": "afterDelay",
  "workbench.experimental.modernUI": false,
  // Editor
  "workbench.startupEditor": "newUntitledFile",
  "workbench.tree.renderIndentGuides": "always",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "explorer.decorations.colors": false,
  "editor.accessibilitySupport": "off",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "editor.linkedEditing": true,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.associations": {
    "*.vue": "html",
    "*.tpl": "jsonc",
    "*.hujson": "jsonc",
    "*.template": "yaml",
    "*.sh.tmpl": "shellscript",
    "*Dockerfile*": "dockerfile"
  },
  // AI / Copilot
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "chat.mcp.gallery.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "dictation.enabled": true,
  "chat.agentFilesLocations": {
    "~/.agents": true
  },
  "chat.agentSkillsLocations": {
    "~/.agents/skills": true
  },
  "chat.tips.enabled": false,
  // Extensions
  "extensions.ignoreRecommendations": true,
  "markdown-preview-enhanced.liveUpdate": true,
  "markdown-preview-enhanced.scrollSync": false,
  // Languages
  "editor.defaultFormatter": "vscode.json-language-features",
  "json.format.keepLines": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "python.createEnvironment.trigger": "off",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "[terraform]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "ansible.lightspeed.enabled": false,
  "ansible.validation.lint.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,
  "docker.extension.enableComposeLanguageServer": false,
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "keep",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "yaml.customTags": [
    "!Equals sequence",
    "!FindInMap sequence",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!Join sequence",
    "!Ref",
    "!Select sequence",
    "!Split sequence",
    "!Sub"
  ],
  // VIM Config
  "vim.leader": "<space>",
  "vim.foldfix": true,
  "vim.surround": true,
  "vim.easymotion": true,
  "vim.visualstar": true,
  "vim.useCtrlKeys": true,
  "vim.targets.enable": true,
  "vim.smartRelativeLine": true,
  "vim.showMarksInGutter": true,
  "vim.useSystemClipboard": true,
  "vim.highlightedyank.enable": true,
  "editor.lineNumbers": "relative",
  "vim.easymotionKeys": "asdghklqwertyuiopzxcvbnmfj",
  "vim.insertModeKeyBindings": [
    {
      "before": [ "j", "k" ],
      "after": [ "<Esc>" ]
    },
    {
      "before": [ "k", "j" ],
      "after": [ "<Esc>" ]
    },
  ],
  "vim.insertModeKeyBindingsNonRecursive": [
    // Disable arrow keys in insert mode
    { "before": [ "<Up>" ], "after": [] },
    { "before": [ "<Down>" ], "after": [] },
    { "before": [ "<Left>" ], "after": [] },
    { "before": [ "<Right>" ], "after": [] },
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [ "<" ],
      "after": [ "<", "g", "v" ]
    },
    {
      "before": [ ">" ],
      "after": [ ">", "g", "v" ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // Disable arrow keys in normal mode
    { "before": [ "<Up>" ], "after": [] },
    { "before": [ "<Down>" ], "after": [] },
    { "before": [ "<Left>" ], "after": [] },
    { "before": [ "<Right>" ], "after": [] },
    { "before": [ "leader", "w" ], "commands": [ ":w!" ] },
    { "before": [ "leader", "q" ], "commands": [ ":q!" ] },
    { "before": [ "leader", "w", "q" ], "commands": [ ":wq!" ] },
    // Splits
    { "before": [ "leader", "v" ], "commands": [ ":vsplit" ] },
    { "before": [ "leader", "h" ], "commands": [ ":split" ] },
    // FLASH.NVIM
    {
      // Flash
      "before": [ "s" ],
      "after": [ "<leader>", "<leader>", "/" ]
    },
    {
      // Flash Treesitter
      "before": [ "S" ],
      "after": [ "<leader>", "<leader>", "<leader>", "j" ]
    }
  ],
  "vim.normalModeKeyBindings": [
    // GENERAL
    {
      "before": [ "<leader>", "f", "s" ],
      "commands": [ "workbench.action.openSettingsJson" ]
    },
    {
      "before": [ "<leader>", "f", "k" ],
      "commands": [ "workbench.action.openGlobalKeybindingsFile" ]
    },
    {
      // Format Document
      "before": [ "<leader>", "c", "f" ],
      "commands": [ "editor.action.formatDocument" ],
      "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
    },
    {
      // New File
      "before": [ "<leader>", "f", "n" ],
      "commands": [ "workbench.action.files.newUntitledFile" ]
    },
    {
      // Quit all
      "before": [ "<leader>", "q", "q" ],
      "commands": [ "workbench.action.quit" ]
    },
    {
      // Go to left split
      "before": [ "<C-h>" ],
      "after": [ "<C-W>", "h" ]
    },
    {
      // Go to lower split
      "before": [ "<C-j>" ],
      "after": [ "<C-W>", "j" ]
    },
    {
      // Go to upper split
      "before": [ "<C-k>" ],
      "after": [ "<C-W>", "k" ]
    },
    {
      // Go to right split
      "before": [ "<C-l>" ],
      "after": [ "<C-W>", "l" ]
    },
    {
      // Search word under cursor
      "before": [ "g", "w" ],
      "after": [ "*" ]
    },
    // LSP
    {
      // Line Diagnostics
      "before": [ "<leader>", "c", "d" ],
      "commands": [ "editor.action.showHover" ],
      "when": "workbench.panel.output.active"
    },
    {
      // Toggle Output
      "before": [ "<leader>", "c", "l" ],
      "commands": [ "workbench.action.output.toggleOutput" ]
    },
    {
      // Goto Definition
      "before": [ "g", "d" ],
      "commands": [ "editor.action.revealDefinition" ]
    },
    {
      // References
      "before": [ "g", "r" ],
      "commands": [ "editor.action.goToReferences" ]
    },
    {
      // Goto Declaration
      "before": [ "g", "D" ],
      "commands": [ "editor.action.revealDeclaration" ]
    },
    {
      // Goto Implementation
      "before": [ "g", "I" ],
      "commands": [ "editor.action.goToImplementation" ]
    },
    {
      // Goto T[y]pe Definition
      "before": [ "g", "y" ],
      "commands": [ "editor.action.goToTypeDefinition" ]
    },
    {
      // Hover
      "before": [ "K" ],
      "commands": [ "editor.action.showHover" ]
    },
    {
      // Signature Help
      "before": [ "g", "K" ],
      "commands": [ "editor.action.triggerParameterHints" ],
      "when": "editorHasSignatureHelpProvider && editorTextFocus"
    },
    {
      // Next Diagnostic
      "before": [ "]", "d" ],
      "commands": [ "editor.action.marker.next" ],
      "when": "editorFocus"
    },
    {
      // Prev Diagnostic
      "before": [ "[", "d" ],
      "commands": [ "editor.action.marker.prev" ],
      "when": "editorFocus"
    },
    {
      // Next Error
      "before": [ "]", "e" ],
      "commands": [ "editor.action.marker.next" ],
      "when": "editorFocus"
    },
    {
      // Prev Error
      "before": [ "[", "e" ],
      "commands": [ "editor.action.marker.prev" ],
      "when": "editorFocus"
    },
    {
      // Next Warning
      "before": [ "]", "w" ],
      "commands": [ "editor.action.marker.next" ],
      "when": "editorFocus"
    },
    {
      // Prev Warning
      "before": [ "[", "w" ],
      "commands": [ "editor.action.marker.prev" ],
      "when": "editorFocus"
    },
    {
      // Code Action
      "before": [ "<leader>", "c", "a" ],
      "commands": [ "editor.action.quickFix" ],
      "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"
    },
    {
      // Rename
      "before": [ "<leader>", "c", "r" ],
      "commands": [ "editor.action.rename" ],
      "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
    },
    // BUFFERLINE.NVIM
    // NOTE: Separate commands required due to VSCode limitations
    {
      // Pin
      "before": [ "<leader>", "b", "p" ],
      "commands": [ "workbench.action.pinEditor" ],
      "when": "!activeEditorIsPinned"
    },
    {
      // Unpin
      "before": [ "<leader>", "b", "u" ],
      "commands": [ "workbench.action.unpinEditor" ],
      "when": "activeEditorIsPinned"
    },
    {
      // Delete non-pinned buffers
      "before": [ "<leader>", "b", "D" ],
      "commands": [ "workbench.action.closeAllEditors" ]
    },
    // NVIM-SPECTRE
    {
      // Replace in files (Spectre)
      "before": [ "<leader>", "s", "r" ],
      "commands": [ "editor.action.startFindReplaceAction" ],
      "when": "editorFocus || editorIsOpen"
    },
    // TELESCOPE.NVIM
    {
      // Search in files
      "before": [ "<leader>", "/" ],
      "commands": [ "workbench.action.findInFiles" ]
    },
    {
      // Open File
      "before": [ "<leader>", "<space>" ],
      "commands": [ "workbench.action.quickOpen" ]
    },
    {
      // Document diagnostics (Problems tab)
      "before": [ "<leader>", "s", "d" ],
      "commands": [ "workbench.actions.view.problems" ],
      "when": "workbench.panel.markers.view.active"
    },
  ],
}
