{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md",
    "~/.agents/instructions/*.md"
  ],
  "model": "~deepseek/deepseek-v4-flash-latest",
  "autoupdate": false,
  "references": {
    "omarchy": {
      "repository": "basecamp/omarchy",
      "description": "Use for Omarchy config and manual details"
    }
  },
  "mcp": {
    "executor": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:4788/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.executor/server-control/token}"
      }
    }
  }
}
