{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Ensure zsh is the default login shell on Linux.
set -euo pipefail

if ! command -v zsh >/dev/null 2>&1; then
    printf '%s\n' "zsh not installed; skipping default shell change." >&2
    exit 0
fi

desired_shell="$(command -v zsh)"
current_shell="$(getent passwd "$USER" | awk -F: '{print $NF}')"

if [[ "$current_shell" != "$desired_shell" ]]; then
    sudo chsh -s "$desired_shell" "$USER"
    printf '%s\n' "Default shell set to $desired_shell. Log out and back in to take effect."
fi
{{- end -}}
