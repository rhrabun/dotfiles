
# ghostty +list-keybinds --default
# ghostty +show-config --default --docs

theme = Catppuccin Frappe

font-size = 15
font-family="FiraCode Nerd Font Mono"
font-thicken=true

window-height=30
window-width=130
background-opacity = 0.95

# Ignore special symbols on Alt + letter
macos-option-as-alt = true

confirm-close-surface=false

# Keybinds
keybind = super+u=toggle_background_opacity

# Create splits (mirror macOS cmd+d on Linux)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Navigate splits (vim-style prefix: ctrl+w, then h/j/k/l)
keybind = ctrl+w>h=goto_split:left
keybind = ctrl+w>j=goto_split:bottom
keybind = ctrl+w>k=goto_split:top
keybind = ctrl+w>l=goto_split:right

# Scroll
keybind = ctrl+alt+arrow_up=scroll_page_lines:-5
keybind = ctrl+alt+arrow_down=scroll_page_lines:5
keybind = ctrl+alt+page_up=scroll_page_lines:-25
keybind = ctrl+alt+page_down=scroll_page_lines:25
