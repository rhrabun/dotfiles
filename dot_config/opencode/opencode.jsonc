{
  "$schema": "https://opencode.ai/config.json",
  "model": "~deepseek/deepseek-v4-flash-latest",
  "update": "disable",
  "references": {
  },
  "mcp": {
    "servers": {
      "rex-community": {
        "type": "remote",
        "url": "https://www.superlogical.com/rex/community-mcp"
      },
      "executor": {
        "type": "remote",
        "url": "{file:~/.config/opencode/executor/url}",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/executor/token}"
        }
      }
    }
  }
}
